# Copiar a .env (no versionado). Valores por defecto para desarrollo local.
PORT=3001
# API REST de Productos (repo ajrm18/apisemana2), incluye el prefijo /api/v1.
PRODUCTOS_API_URL=http://localhost:3000/api/v1
# API GraphQL de Productos (repo ajrm18/nestjs-productos-graphql).
GRAPHQL_URL=https://nestjs-productos-graphql-tgv7.onrender.com/graphql
# Timeout por fuente en milisegundos.
FUENTE_TIMEOUT_MS=8000
